rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/customers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Customer Profiles: customers/{uid}
    // Any authenticated user can read profiles; only owner can create/update
    match /customers/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // 2. Seller Profiles: sellers/{uid}
    // Any authenticated user can view seller details; only owner can create/update
    match /sellers/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // 3. Books Marketplace: books/{bookId}
    // Public read so students can browse books; only owner seller can modify/delete
    match /books/{bookId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'availability', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
    }

    // 4. User Wishlist: users/{uid}/wishlist/{bookId}
    // Strictly private to each user
    match /users/{uid}/wishlist/{bookId} {
      allow read, write: if isOwner(uid);
    }

    // 5. Orders: orders/{orderId}
    // Customers create orders for themselves; visible only to buyer and seller
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 6. Admin Registry: admins/{uid}
    // Read allowed for authenticated users to verify authorization state; write restricted to existing admins
    match /admins/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Academic Syllabuses: syllabuses/{syllabusId}
    // Public read for students to download; strictly managed by verified administrators
    match /syllabuses/{syllabusId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 8. Previous Year Question Papers: questionPapers/{questionPaperId}
    // - Public read: only approved & active papers
    // - Admin read: all papers (pending, approved, rejected)
    // - Submitter read: own submissions
    // - Create: authenticated users can submit with status 'pending'
    // - Update / Delete / Approve / Reject: strictly verified administrators
    match /questionPapers/{questionPaperId} {
      allow read: if (resource.data.status == 'approved' && resource.data.isActive == true) ||
                     isAdmin() ||
                     (isAuthenticated() && resource.data.uploadedBy == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
