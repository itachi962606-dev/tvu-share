rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Book Cover Images: book-images/{sellerId}/{bookId}/{fileName}
    match /book-images/{sellerId}/{bookId}/{fileName} {
      // Allow public read so all students and faculty can view book images
      allow read: if true;

      // Allow write only if authenticated user matches sellerId and image is under 5MB
      allow write: if request.auth != null
                   && request.auth.uid == sellerId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Allow delete only if authenticated user is the owner seller
      allow delete: if request.auth != null && request.auth.uid == sellerId;
    }
  }
}
